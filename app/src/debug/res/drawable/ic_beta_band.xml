<?xml version="1.0" encoding="utf-8"?>
<!--
  Pita "BETA" yang ditumpuk di atas foreground ikon launcher, HANYA untuk build
  debug (source set `src/debug/`) — build release tak pernah melihat berkas ini.

  Seluruh gambar ditahan di dalam kotak aman adaptive-icon (pusat 72dp dari
  kanvas 108dp, kira-kira x/y 18..90). Di luar itu launcher berhak memotong
  sesuai bentuk mask-nya (lingkaran, squircle, dst), dan pita yang menyentuh
  tepi akan terpotong tak beraturan di sebagian HP.

  Huruf digambar sebagai kotak-kotak, bukan teks: VectorDrawable tak punya
  elemen teks, dan memakai font berarti bergantung pada apa yang terpasang di
  perangkat.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Pita oranye: warna sengaja jauh dari biru produksi (#0D47A1) supaya
         terbaca beda bahkan saat ikonnya kecil di layar penuh aplikasi. -->
    <path
        android:fillColor="#E65100"
        android:pathData="M16,68 H92 V90 H16 Z" />

    <!-- B E T A, putih di atas pita. Satu path, banyak sub-path. -->
