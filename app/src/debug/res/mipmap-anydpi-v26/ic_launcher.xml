<?xml version="1.0" encoding="utf-8"?>
<!--
  Override khusus build DEBUG (source set `src/debug/`). Salinan berkas di
  `src/main/`, hanya foreground-nya diganti versi ber-pita BETA.

  Berlaku API 26+. Perangkat API 24/25 (minSdk repo ini = 24) memakai
  `mipmap-*/ic_launcher.png` yang statis dan tak bisa ditumpuk tanpa membuat
  PNG baru — di sana penandanya adalah NAMA app ("Tridjaya BETA", lihat
  `src/debug/res/values/strings.xml`), yang berlaku di SEMUA versi Android.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
  <background android:drawable="@mipmap/ic_launcher_background"/>
  <foreground android:drawable="@drawable/ic_launcher_foreground_beta"/>
  <monochrome android:drawable="@mipmap/ic_launcher_monochrome"/>
</adaptive-icon>
